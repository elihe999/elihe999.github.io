      &lt;/defs&gt;

      &lt;rect x=&#34;0&#34; y=&#34;0&#34; width=&#34;1240&#34; height=&#34;760&#34; fill=&#34;#FFFFFF&#34;/&gt;
      &lt;rect x=&#34;0&#34; y=&#34;0&#34; width=&#34;1240&#34; height=&#34;760&#34; fill=&#34;url(#grid)&#34;/&gt;

