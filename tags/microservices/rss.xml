        &lt;/pattern&gt;
        &lt;filter id=&#34;rough&#34; x=&#34;-6%&#34; y=&#34;-6%&#34; width=&#34;112%&#34; height=&#34;118%&#34;&gt;
          &lt;feTurbulence type=&#34;fractalNoise&#34; baseFrequency=&#34;0.017&#34; numOctaves=&#34;3&#34; seed=&#34;3&#34; result=&#34;n&#34;/&gt;
          &lt;feDisplacementMap in=&#34;SourceGraphic&#34; in2=&#34;n&#34; scale=&#34;5.2&#34; xChannelSelector=&#34;R&#34; yChannelSelector=&#34;G&#34;/&gt;
        &lt;/filter&gt;
