          &lt;feTurbulence type=&#34;fractalNoise&#34; baseFrequency=&#34;0.024&#34; numOctaves=&#34;2&#34; seed=&#34;7&#34; result=&#34;n&#34;/&gt;
          &lt;feDisplacementMap in=&#34;SourceGraphic&#34; in2=&#34;n&#34; scale=&#34;3.4&#34; xChannelSelector=&#34;R&#34; yChannelSelector=&#34;G&#34;/&gt;
        &lt;/filter&gt;
        &lt;marker id=&#34;arrow&#34; viewBox=&#34;0 0 10 10&#34; refX=&#34;8.5&#34; refY=&#34;5&#34;
                markerWidth=&#34;7.5&#34; markerHeight=&#34;7.5&#34; orient=&#34;auto-start-reverse&#34;&gt;
          &lt;path d=&#34;M0.5,0.8 L9,5 L0.5,9.2 L2.6,5 Z&#34; fill=&#34;context-stroke&#34;/&gt;
        &lt;/marker&gt;
        &lt;marker id=&#34;arrowMute&#34; viewBox=&#34;0 0 10 10&#34; refX=&#34;8.5&#34; refY=&#34;5&#34;
