    <item>
      <title>微服务系统架构图 · 数据中台</title>
      <link>/posts/%E5%BE%AE%E6%9C%8D%E5%8A%A1%E7%B3%BB%E7%BB%9F%E6%9E%B6%E6%9E%84%E5%9B%BE-%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%8F%B0/</link>
      <pubDate>Mon, 06 Jul 2026 10:00:00 +0800</pubDate><author>eli@example.com (Eli He)</author>
      <guid>/posts/%E5%BE%AE%E6%9C%8D%E5%8A%A1%E7%B3%BB%E7%BB%9F%E6%9E%B6%E6%9E%84%E5%9B%BE-%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%8F%B0/</guid>
      <description>&lt;p&gt;微服务架构是现代企业系统的核心范式。本文通过一张交互式架构图，展示从&lt;strong&gt;网关层&lt;/strong&gt;到&lt;strong&gt;业务服务层&lt;/strong&gt;、&lt;strong&gt;数据中台层&lt;/strong&gt;、&lt;strong&gt;基础设施层&lt;/strong&gt;的完整数据流与服务依赖关系。&lt;/p&gt;

&lt;style&gt;
  :root{
    --ink:#1F2937; --ink2:#475467; --muted:#667085; --line:#D0D5DD;
    --gw-fill:#F5F3FF; --gw-stroke:#7A5AF8;
    --biz-fill:#EFF8FF; --biz-stroke:#175CD3;
    --data-fill:#FFF7ED; --data-stroke:#C4320A;
    --infra-fill:#ECFDF3; --infra-stroke:#027A48;
  }
  .micro-wrap{max-width:1280px; margin:0 auto;}
  .micro-wrap h2{font-size:26px; margin:0 0 4px; letter-spacing:.5px; color:var(--ink);}
  .micro-sub{color:var(--muted); font-size:14px; margin:0 0 18px;}
  .micro-legend{
    display:flex; flex-wrap:wrap; gap:14px; align-items:center;
    background:#fff; border:1.5px solid var(--line); border-radius:12px;
    padding:12px 16px; margin-bottom:18px; box-shadow:2px 3px 0 rgba(31,41,55,.06);
  }
  .micro-legend b{font-size:13px; color:var(--ink2); margin-right:6px;}
  .lg-item{display:flex; align-items:center; gap:7px; font-size:13px; color:var(--ink2);}
  .lg-swatch{width:22px; height:14px; border:2px solid; border-radius:4px;}
  .micro-hint{margin-left:auto; font-size:12px; color:var(--muted);}
  .micro-stage{
    background:#fff; border:1.5px solid var(--line); border-radius:14px;
    padding:10px; box-shadow:3px 4px 0 rgba(31,41,55,.07);
    overflow:auto;
  }
  .micro-stage svg{display:block; width:100%; height:auto;}
  .micro-stage .edge{
    fill:none; stroke:#94A3B8; stroke-width:2; stroke-linecap:round; stroke-linejoin:round;
    transition:stroke .18s, stroke-width .18s, opacity .18s;
  }
  .micro-stage .edge-label{
    font-size:11px; fill:var(--muted); paint-order:stroke;
    stroke:#fff; stroke-width:3px; stroke-linejoin:round;
    transition:fill .18s, opacity .18s;
  }
  .micro-stage .node{cursor:pointer;}
  .micro-stage .node-box{transition:stroke-width .18s, filter .18s;}
  .micro-stage .node-name{font-size:17px; font-weight:700; fill:var(--ink);}
  .micro-stage .node-sub{font-size:12px; fill:var(--muted);}
  .micro-stage svg.dim .edge{stroke:#E6E8EC; opacity:.55;}
  .micro-stage svg.dim .edge-label{opacity:.35;}
  .micro-stage svg.dim .node{opacity:.4;}
  .micro-stage svg.dim .edge.hl{stroke:#7A5AF8; stroke-width:3.4; opacity:1;}
  .micro-stage svg.dim .edge-label.hl{fill:#7A5AF8; opacity:1;}
  .micro-stage svg.dim .node.hl{opacity:1;}
  .micro-stage svg.dim .node.hl .node-box{stroke-width:3.6;}
  .micro-stage svg:not(.dim) .node:hover .node-box{stroke-width:3.2;}
&lt;/style&gt;

&lt;div class=&#34;micro-wrap&#34;&gt;
  &lt;div class=&#34;micro-legend&#34;&gt;
    &lt;b&gt;层级图例&lt;/b&gt;
    &lt;div class=&#34;lg-item&#34;&gt;&lt;span class=&#34;lg-swatch&#34; style=&#34;background:var(--gw-fill);border-color:var(--gw-stroke)&#34;&gt;&lt;/span&gt;网关层&lt;/div&gt;
    &lt;div class=&#34;lg-item&#34;&gt;&lt;span class=&#34;lg-swatch&#34; style=&#34;background:var(--biz-fill);border-color:var(--biz-stroke)&#34;&gt;&lt;/span&gt;业务服务层&lt;/div&gt;
    &lt;div class=&#34;lg-item&#34;&gt;&lt;span class=&#34;lg-swatch&#34; style=&#34;background:var(--data-fill);border-color:var(--data-stroke)&#34;&gt;&lt;/span&gt;数据中台层&lt;/div&gt;
    &lt;div class=&#34;lg-item&#34;&gt;&lt;span class=&#34;lg-swatch&#34; style=&#34;background:var(--infra-fill);border-color:var(--infra-stroke)&#34;&gt;&lt;/span&gt;基础设施层&lt;/div&gt;
    &lt;span class=&#34;micro-hint&#34;&gt;提示：悬停或点击服务节点，可高亮其所有连接关系&lt;/span&gt;
  &lt;/div&gt;

  &lt;div class=&#34;micro-stage&#34;&gt;
