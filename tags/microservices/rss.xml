        &lt;path class=&#34;edge&#34; data-from=&#34;data-asset&#34; data-to=&#34;data-svc&#34;  d=&#34;M845,406 Q880,396 915,406&#34; marker-end=&#34;url(#arrow)&#34;/&gt;
        &lt;path class=&#34;edge&#34; data-from=&#34;data-in&#34;  data-to=&#34;db-pg&#34;      d=&#34;M230,452 Q510,505 795,540&#34; marker-end=&#34;url(#arrow)&#34;/&gt;
        &lt;path class=&#34;edge&#34; data-from=&#34;data-model&#34; data-to=&#34;db-pg&#34;    d=&#34;M490,452 Q645,500 795,540&#34; marker-end=&#34;url(#arrow)&#34;/&gt;
