        &lt;rect x=&#34;18&#34; y=&#34;200&#34; width=&#34;1204&#34; height=&#34;150&#34; rx=&#34;14&#34; fill=&#34;#F6FBFF&#34; stroke=&#34;#DBEAFE&#34; stroke-width=&#34;1.5&#34;/&gt;
        &lt;rect x=&#34;18&#34; y=&#34;360&#34; width=&#34;1204&#34; height=&#34;150&#34; rx=&#34;14&#34; fill=&#34;#FFFBF4&#34; stroke=&#34;#FCE7C2&#34; stroke-width=&#34;1.5&#34;/&gt;
        &lt;rect x=&#34;18&#34; y=&#34;520&#34; width=&#34;1204&#34; height=&#34;150&#34; rx=&#34;14&#34; fill=&#34;#F4FCF6&#34; stroke=&#34;#BBF7D0&#34; stroke-width=&#34;1.5&#34;/&gt;
      &lt;/g&gt;
      &lt;g font-size=&#34;12&#34; fill=&#34;#9AA1AC&#34; font-family=&#34;&#39;Segoe Print&#39;,cursive&#34;&gt;
        &lt;text x=&#34;32&#34; y=&#34;58&#34;&gt;网关层 · Gateway&lt;/text&gt;
